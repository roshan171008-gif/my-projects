#include <stdio.h>
#include <string.h>

int main()
{
    char entered[20], site[30], user[30], pass[30];
    int choice, i;
    FILE *fp;

    printf("Enter master password: ");
    scanf("%s", entered);

    if (strcmp(entered, "admin123") != 0)
    {
        printf("Wrong password!\n");
        return 0;
    }

    do
    {
        printf("\n1. Add Password\n2. View Passwords\n3. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        if (choice == 1)
        {
            printf("Website: ");
            scanf("%s", site);
            printf("Username: ");
            scanf("%s", user);
            printf("Password: ");
            scanf("%s", pass);

            /* hide the password: add 3 to each character */
            for (i = 0; pass[i] != '\0'; i++)
                pass[i] = pass[i] + 3;

            fp = fopen("passwords.txt", "a");
            fprintf(fp, "%s %s %s\n", site, user, pass);
            fclose(fp);
            printf("Saved!\n");
        }
        else if (choice == 2)
        {
            fp = fopen("passwords.txt", "r");
            if (fp == NULL)
            {
                printf("No passwords saved yet.\n");
                continue;
            }
            while (fscanf(fp, "%s %s %s", site, user, pass) == 3)
            {
                /* get the real password back: subtract 3 */
                for (i = 0; pass[i] != '\0'; i++)
                    pass[i] = pass[i] - 3;

                printf("%s  %s  %s\n", site, user, pass);
            }
            fclose(fp);
        }
    } while (choice != 3);

    return 0;
}