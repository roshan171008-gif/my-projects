#include <stdio.h>

int main()
{
    int pin = 1234;
    int entered, choice, attempts = 0;
    float balance = 5000, amount;

    /* PIN check - 3 chances */
    while (attempts < 3)
    {
        printf("Enter your PIN: ");
        scanf("%d", &entered);

        if (entered == pin)
            break;

        attempts++;
        printf("Wrong PIN!\n");
    }

    if (attempts == 3)
    {
        printf("Card blocked.\n");
        return 0;
    }

    /* Menu */
    do
    {
        printf("\n--- ATM MENU ---\n");
        printf("1. Check Balance\n");
        printf("2. Deposit\n");
        printf("3. Withdraw\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
        case 1:
            printf("Balance = %.2f\n", balance);
            break;

        case 2:
            printf("Enter amount to deposit: ");
            scanf("%f", &amount);
            if (amount > 0)
            {
                balance = balance + amount;
                printf("Deposited. New balance = %.2f\n", balance);
            }
            else
                printf("Invalid amount!\n");
            break;

        case 3:
            printf("Enter amount to withdraw: ");
            scanf("%f", &amount);
            if (amount <= 0)
                printf("Invalid amount!\n");
            else if (amount > balance)
                printf("Insufficient balance!\n");
            else
            {
                balance = balance - amount;
                printf("Collect your cash. Balance = %.2f\n", balance);
            }
            break;

        case 4:
            printf("Thank you! Goodbye.\n");
            break;

        default:
            printf("Invalid choice!\n");
        }
    } while (choice != 4);

    return 0;
}
